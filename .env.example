# PostgreSQL
POSTGRES_DB=ai_assistants
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/ai_assistants?sslmode=disable

# Backend
PORT=8080
JWT_SECRET=supersecretkey
JWT_EXPIRY=24h

# Фиксированные UUID для dummyLogin
ADMIN_UUID=00000000-0000-0000-0000-000000000001
USER_UUID=00000000-0000-0000-0000-000000000002

# LLM провайдер: mock или openai
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8080